name                    = "contoso-demo"
aws_region              = "eu-central-1"
admin_cidrs             = ["203.0.113.10/32"] # EXAMPLE ONLY: replace with your current public IPv4 /32
admin_principal_arn     = "arn:aws:iam::123456789012:role/replace-with-your-deployment-role"
kubernetes_version      = "1.36"
postgres_engine_version = "17" # Pin the resolved exact minor before live apply
node_count              = 2
node_instance_types     = ["t3.medium"]
db_instance_class       = "db.t4g.small"
nat_per_az              = false # Cost-saving demo choice, not HA egress
db_multi_az             = false # Two subnet AZs do not make a single RDS instance Multi-AZ
enable_waf              = true
db_deletion_protection  = true
db_skip_final_snapshot  = false
