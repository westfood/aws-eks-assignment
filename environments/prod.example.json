{
  "environment": "prod",
  "aws_account_id": "REPLACE_WITH_PROD_ACCOUNT_ID",
  "aws_profile": "contoso-prod",
  "aws_region": "eu-central-1",
  "state_bucket_name": "replace-with-unique-prod-state-bucket",
  "infra": {
    "name": "contoso",
    "admin_cidrs": [
      "203.0.113.10/32"
    ],
    "admin_principal_arn": "arn:aws:iam::123456789012:role/replace-with-selected-account-role",
    "vpc_cidr": "10.44.0.0/16",
    "kubernetes_version": "1.36",
    "postgres_engine_version": "17",
    "node_count": 2,
    "node_instance_types": [
      "t3.medium"
    ],
    "db_instance_class": "db.t4g.small",
    "nat_per_az": true,
    "db_multi_az": true,
    "db_deletion_protection": true,
    "db_skip_final_snapshot": false,
    "enable_waf": true,
    "private_only_api": false,
    "manage_ecr_registry_scanning": true,
    "ecr_scan_type": "ENHANCED"
  }
}
